<!--
    WiX version lockstep (ticket #31): the wix CLI in .config/dotnet-tools.json,
    the WixToolset.Sdk/<version> attribute of this file, and the WixToolset.*
    extension PackageReferences below must all move together to the same
    WiX version. A bump that moves only one of them breaks the installer build.
    WiX major bumps also need the AcceptEula value refreshed (v7: wix7).
-->
<Project Sdk="WixToolset.Sdk/7.0.1">
    <PropertyGroup>
        <BuildVersion>0.1.1</BuildVersion>
        <HarvestPath>..\..\output\WebContent</HarvestPath>
        <!-- #82: the Event Server service custom-action exe. Built by the ProjectReference
             below (never harvested - it rides the MSI as a Binary stream, not in the drop);
             the path carries $(Configuration) so the Binary always matches this build.
             #77: the deployment-CA provisioning exe, same posture (Binary stream, not drop). -->
        <ServiceCtlExePath>..\WebContentServiceCtl\bin\$(Configuration)\WebContentServiceCtl.exe</ServiceCtlExePath>
        <ProxyCaExePath>..\WebContentProxyCa\bin\$(Configuration)\WebContentProxyCa.exe</ProxyCaExePath>
        <DefineConstants>Version=$(BuildVersion);HarvestPath=$(HarvestPath);ServiceCtlExePath=$(ServiceCtlExePath);ProxyCaExePath=$(ProxyCaExePath)</DefineConstants>
        <OutputPath>..\..\output\Setup</OutputPath>
        <OutputName>CascadiaWebContentPlugin.$(BuildVersion)</OutputName>
        <SuppressIces>ICE61</SuppressIces>
        <!-- WiX v7 enforces the OSMF EULA; direct acceptance for CI (docs: firegiant /wix/osmf). -->
        <AcceptEula>wix7</AcceptEula>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="WixToolset.UI.wixext" Version="7.0.1" />
        <PackageReference Include="WixToolset.Util.wixext" Version="7.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../WebContent/WebContent.csproj" />
        <!-- #82: build-order only; the CA exe is consumed as a Binary SourceFile, never linked. -->
        <ProjectReference Include="../WebContentServiceCtl/WebContentServiceCtl.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
        <!-- #77: same posture for the deployment-CA helper exe. -->
        <ProjectReference Include="../WebContentProxyCa/WebContentProxyCa.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
    </ItemGroup>

    <PropertyGroup>
        <PreBuildEvent>
        </PreBuildEvent>
    </PropertyGroup>
</Project>