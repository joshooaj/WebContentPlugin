<!--
    WiX version lockstep (ticket #31): the wix CLI in .config/dotnet-tools.json,
    the WixToolset.Sdk/<version> attribute of this file, and the WixToolset.*
    extension PackageReferences below must all move together to the same
    WiX version. A bump that moves only one of them breaks the installer build.
    WiX major bumps also need the AcceptEula value refreshed (v7: wix7).
-->
<Project Sdk="WixToolset.Sdk/7.0.1">
    <PropertyGroup>
        <BuildVersion>0.1.1</BuildVersion>
        <HarvestPath>..\..\output\WebContent</HarvestPath>
        <DefineConstants>Version=$(BuildVersion);HarvestPath=$(HarvestPath)</DefineConstants>
        <OutputPath>..\..\output\Setup</OutputPath>
        <OutputName>CascadiaWebContentPlugin.$(BuildVersion)</OutputName>
        <SuppressIces>ICE61</SuppressIces>
        <!-- WiX v7 enforces the OSMF EULA; direct acceptance for CI (docs: firegiant /wix/osmf). -->
        <AcceptEula>wix7</AcceptEula>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="WixToolset.UI.wixext" Version="7.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../WebContent/WebContent.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <PreBuildEvent>
        </PreBuildEvent>
    </PropertyGroup>
</Project>