<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK-style net472 so the plugin builds with `dotnet build src/WebContent/WebContent.csproj`
    (no full-MSBuild dependency). The plugin is loaded into 64-bit XProtect hosts, but the
    project itself stays Platform=Any CPU — x64 is pinned unconditionally via PlatformTarget —
    so the .sln can map its x64 solution platform onto this project's Any CPU configuration
    (same remap the UxTests project uses).
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>WebContent</RootNamespace>
    <AssemblyName>WebContent</AssemblyName>
    <ProjectGuid>{01DD540B-2AF6-4F94-A4EE-CF4E32598513}</ProjectGuid>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- OutputPath is the MIP drop folder harvested by src/Setup; do not append net472 to it. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <BuildVersion>0.1.1</BuildVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>..\..\output\WebContent\</OutputPath>
    <DefineConstants>DEBUG;TRACE;NETFRAMEWORK</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>..\..\output\WebContent\</OutputPath>
    <DefineConstants>TRACE;NETFRAMEWORK</DefineConstants>
  </PropertyGroup>

  <!--
    Only framework assemblies the SDK does not add implicitly: UseWPF/UseWindowsForms cover
    PresentationCore/PresentationFramework/WindowsBase/System.Xaml/System.Windows.Forms/System.Drawing,
    and the net472 default item set covers System/System.Core/System.Data/System.Xml/System.Xml.Linq/
    System.Net.Http/System.Runtime.Serialization.
  -->
  <ItemGroup>
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceModel.Web" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2">
      <Version>1.0.4314.35</Version>
    </PackageReference>
    <PackageReference Include="MilestoneSystems.VideoOS.Platform">
      <Version>26.1.2</Version>
    </PackageReference>
    <PackageReference Include="Nerdbank.GitVersioning">
      <Version>3.10.94</Version>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    #72: the elevated trust helper rides the same build and lands in the same drop (its csproj
    pins the identical OutputPath). ReferenceOutputAssembly=false: the plugin never links the
    exe, it only ShellExecute's it from disk at fix time - keeping "the plugin cannot itself
    write a trust store" true at the assembly level, not just by convention.
  -->
  <ItemGroup>
    <ProjectReference Include="..\WebContentTrustHelper\WebContentTrustHelper.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.def">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Include="license.rtf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\CompanyLogo.png" />
    <Resource Include="Resources\icon.ico" />
    <Resource Include="Resources\WebContentIcon.png" />
    <Resource Include="Resources\WorkspaceScreenshot.png" />
  </ItemGroup>

  <!--
    Replace the host-owned VideoOS assemblies (and their satellite folders) NuGet copies into
    the drop; the XProtect host already provides them. Replaces the legacy cmd PostBuildEvent
    (del /s /q + for /R /D rd) that depended on the build-event CWD quirk.
    $(OutDir) is relative in SDK-style projects while wildcard items come back absolute: anchor
    both to the same absolute path or the "never remove the drop root" Remove below misses and
    the recursive RemoveDir wipes the whole drop.
  -->
  <Target Name="CleanHostAssemblies" AfterTargets="Build">
    <PropertyGroup>
      <DropDirAbsolute>$([System.IO.Path]::GetFullPath($(OutDir)))</DropDirAbsolute>
    </PropertyGroup>
    <ItemGroup>
      <HostOwnedFiles Include="$(DropDirAbsolute)**\VideoOS.*" />
    </ItemGroup>
    <Delete Files="@(HostOwnedFiles)" />
    <ItemGroup>
      <HostOwnedCultureFolders Include="@(HostOwnedFiles->'%(RootDir)%(Directory)')" />
      <!-- Never remove the drop root itself. -->
      <HostOwnedCultureFolders Remove="$(DropDirAbsolute)" />
    </ItemGroup>
    <RemoveDir Directories="@(HostOwnedCultureFolders)" />
  </Target>

  <Target Name="RestoreDotNetTools" BeforeTargets="GenerateSbom">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <!--
    The invocation text below is pinned by SbomGenerationGuardTests: quoted absolute -bc
    component path and -D true (self-overwriting manifest dirs). Keep it on one line and
    update the guards before restructuring.
  -->
  <Target Name="GenerateSbom" AfterTargets="CleanHostAssemblies">
    <PropertyGroup>
      <SbomDropPath>$([System.IO.Path]::GetFullPath($(OutDir)).TrimEnd('\'))</SbomDropPath>
    </PropertyGroup>
    <Exec Command='dotnet tool run sbom-tool generate -b "$(SbomDropPath)" -bc "$(MSBuildProjectDirectory)" -pn CascadiaWebContentPlugin -pv $(BuildVersion) -ps "Cascadia Technology" -nsb https://cascadia.tech/joshooaj -D true -V Warning'
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
