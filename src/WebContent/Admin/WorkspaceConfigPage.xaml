<UserControl x:Class="WebContent.Admin.WorkspaceConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="760"
             Background="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/WebContent;component/Admin/AdminPageStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- #81: the one scheme set the grid dropdown offers - exactly what ProxyPolicy accepts. -->
      <x:Array x:Key="ProxySchemes" Type="{x:Type sys:String}">
        <sys:String>http</sys:String>
        <sys:String>https</sys:String>
      </x:Array>
    </ResourceDictionary>
  </UserControl.Resources>

  <!--
    Ticket #74: the workspace config page is now a tabbed shell. The Settings tab carries the
    existing content verbatim; Proxy/Diagnostics are landing panels for the epic tickets (#81,
    #85, #86, #84) and hold NO input controls - a placeholder tab must never dirty the pane. Status
    is live since #76 and is strictly read-only. Status starts collapsed: the item manager shows it
    only after the workspace item's SecurityActions Manage (edit-rights) check passes for the
    current MC user.
    #81 took the Proxy tab live: the whole proxy section (routing toggle, the structured allowlist
    grid, the wildcard warning, the fetch harness) now lives there - the Settings tab keeps no
    proxy controls. Diagnostics stays a placeholder until #84.
    Tab x:Names are UIA AutomationIds - the ux probes and later tickets select tabs by them.
  -->
  <TabControl x:Name="workspaceTabs" Background="White"
              BorderBrush="{StaticResource Brush.Card.Border}" BorderThickness="0,1,0,0">
    <TabControl.Resources>
      <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,6" />
      </Style>
    </TabControl.Resources>

    <TabItem x:Name="tabSettings" Header="Settings">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" Margin="20,16,20,24">

          <!-- Ticket #27: broken-definition banner, shown by SignalLoadDefect. -->
          <Border x:Name="configError" Style="{StaticResource ErrorBannerStyle}" Visibility="Collapsed">
            <TextBlock x:Name="configErrorText" Style="{StaticResource ErrorBannerTextStyle}" />
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Name:" />
              <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1"
                       Style="{StaticResource FormTextBoxStyle}" Text="New Workspace"
                       MaxLength="128" TextChanged="OnUserChanged" />

              <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Home address:" />
              <TextBox x:Name="txtHomeAddress" Grid.Row="1" Grid.Column="1"
                       Style="{StaticResource FormTextBoxStyle}"
                       MaxLength="2048" TextChanged="OnUserChanged" />
            </Grid>
          </Border>

          <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Display" />
          <CheckBox x:Name="chkHideToolbar" Content="Hide toolbar"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnHideToolbarChanged" Unchecked="OnHideToolbarChanged" />
          <CheckBox x:Name="chkHideAddress" Content="Hide address"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblZoomLevel" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Zoom level:" Margin="0,6,12,6" />
            <TextBox x:Name="txtZoomLevel" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"
                     Width="70" Text="100" TextAlignment="Right"
                     MaxLength="4" TextChanged="OnZoomLevelTextChanged" />
            <Slider x:Name="zoomSlider" Grid.Column="2" Minimum="25" Maximum="500" Value="100"
                    TickFrequency="25" TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                    LargeChange="25" SmallChange="5" VerticalAlignment="Center"
                    Margin="12,0,0,0" MaxWidth="360" HorizontalAlignment="Left" Width="360"
                    ValueChanged="OnZoomSliderValueChanged" />
          </Grid>

          <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Behavior" />
          <CheckBox x:Name="chkRememberLastAddress" Content="Remember last address"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />
          <CheckBox x:Name="chkAllowBackgroundBrowser" Content="Allow browser to run in background"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />
          <CheckBox x:Name="chkAllowAudioNotifications" Content="Allow audio notifications"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />
          <CheckBox x:Name="chkMuteAudio" Content="Mute audio"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />

          <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Privacy" />
          <CheckBox x:Name="chkClearBrowsingDataOnExit" Content="Clear history on exit"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />

          <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Advanced" />
          <CheckBox x:Name="chkIsolateBrowserInstances" Content="Isolate this browser instance"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />
          <CheckBox x:Name="chkEnableDevTools" Content="Enable developer tools (F12)"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem x:Name="tabProxy" Header="Proxy">
      <!--
        Ticket #81: the proxy section lives here in full - the routing toggle, the structured
        allowlist grid that replaces the free-text one-line-per-entry box, the full-host-wildcard
        warning banner, and the #53 fetch harness the admin uses to prove a gate decision. Every
        entry is a row: scheme dropdown, wildcard-aware host, optional port, accept-untrusted
        checkbox (the old free-text "accept-untrusted" token is gone from the UI), plus an inline
        Problem cell so a refused entry is flagged on its row and its save refused by name -
        never silently dropped. Entries load from either stored shape (#73) and save structured.
      -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" Margin="20,16,20,24">
          <TextBlock x:Name="txtProxyTabHeading" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" Text="Proxy" />
          <CheckBox x:Name="chkProxyEnabled" Content="Route web traffic through the VMS server proxy"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />

          <TextBlock x:Name="lblProxyTargets" Style="{StaticResource FieldLabelStyle}" Text="Proxy targets:" Margin="0,10,0,2" />

          <Border x:Name="proxyWildcardWarning" Style="{StaticResource WarningBannerStyle}" Visibility="Collapsed">
            <TextBlock x:Name="txtProxyWildcardWarning" Style="{StaticResource WarningBannerTextStyle}" TextWrapping="Wrap" />
          </Border>

          <!--
            Every cell is a live editor (template columns, no grid edit mode) so the row's Problem
            cell always shows why a half-typed entry is refused. Virtualization is off: the list is
            a handful of rows, and a probe (or a admin) must see every row realized.
          -->
          <DataGrid x:Name="dgProxyTargets" AutoGenerateColumns="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                    CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                    CanUserSortColumns="False" CanUserReorderColumns="False"
                    VirtualizingPanel.IsVirtualizing="False"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    MinHeight="72" MaxHeight="260" Margin="0,2,0,0">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Error.Background}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Scheme" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <!--
                      UpdateSourceTrigger=PropertyChanged is load-bearing here, not decoration: a
                      DataGrid defers the source update of any cell-content binding that does not
                      ask for it (learned live on #81 - picking http in this dropdown changed the
                      row's display and silently stored https; the accept-untrusted checkbox fell
                      into the same trap one run later). The grid's whole design is "every cell is
                      a live editor", so every writeable cell binding says PropertyChanged.
                    -->
                    <ComboBox x:Name="cmbProxyRowScheme" AutomationProperties.AutomationId="proxyRowScheme"
                              ItemsSource="{StaticResource ProxySchemes}"
                              SelectedItem="{Binding Scheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center" Margin="2" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Host" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBox x:Name="txtProxyRowHost" AutomationProperties.AutomationId="proxyRowHost"
                             Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="253" VerticalAlignment="Center" Margin="2" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Port" Width="70">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBox x:Name="txtProxyRowPort" AutomationProperties.AutomationId="proxyRowPort"
                             Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="5" TextAlignment="Right" VerticalAlignment="Center" Margin="2" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Accept untrusted" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox x:Name="chkProxyRowUntrusted" AutomationProperties.AutomationId="proxyRowUntrusted"
                              IsChecked="{Binding AcceptUntrusted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Problem" Width="170">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock x:Name="txtProxyRowProblem" AutomationProperties.AutomationId="proxyRowProblem"
                               Text="{Binding ErrorText}" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Error.Foreground}"
                               VerticalAlignment="Center" Margin="2" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Remove" Width="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button x:Name="btnProxyRowRemove" AutomationProperties.AutomationId="proxyRowRemove"
                            Content="Remove" Padding="6,2" Margin="2"
                            VerticalAlignment="Center" Click="OnProxyRowRemove" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="btnProxyTargetAdd" Content="Add target" Padding="10,4" Click="OnProxyTargetAdd" />
            <TextBlock x:Name="lblProxyRowCounter" Style="{StaticResource SecondaryTextStyle}"
                       Margin="12,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="lblProxyTargetsHint" Style="{StaticResource SecondaryTextStyle}"
                     TextWrapping="Wrap" Margin="0,4,0,0" />

          <!-- Ticket #53 demo harness: Management Client-driven proxy fetch across MIP messaging. -->
          <TextBlock x:Name="lblProxyTestUrl" Style="{StaticResource FieldLabelStyle}" Text="Test proxy fetch:" Margin="0,14,0,2" />
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="txtProxyTestUrl" Style="{StaticResource FormTextBoxStyle}" Width="470"
                     VerticalAlignment="Center" MaxLength="2048" />
            <Button x:Name="btnProxyTestFetch" Content="Fetch via Event Server" Margin="10,0,0,0"
                    Padding="10,4" VerticalAlignment="Center" Click="OnProxyTestFetch" />
          </StackPanel>
          <TextBlock x:Name="lblProxyTestHint" Style="{StaticResource SecondaryTextStyle}"
                     TextWrapping="Wrap" Margin="0,2,0,0" />
          <TextBlock x:Name="lblProxyTestResult" Style="{StaticResource SecondaryTextStyle}"
                     TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="Bold" Visibility="Collapsed" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem x:Name="tabDiagnostics" Header="Diagnostics">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" Margin="20,16,20,24">
          <TextBlock x:Name="txtDiagnosticsTabHeading" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" Text="Diagnostics" />
          <TextBlock x:Name="txtDiagnosticsTabPlaceholder" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                     Text="Recently blocked proxy resources for this workspace, with one-click promotion into the allowlist, land on this tab (#69/#84)." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem x:Name="tabStatus" Header="Status" Visibility="Collapsed">
      <!--
        Ticket #76: live proxy sessions for this workspace, pulled from the Event Server's status
        snapshot (#69) every few seconds while this tab is the selected one - and never outside the
        role gate that made the tab visible at all (#74). The grid is read-only: the tab reports,
        it writes no configuration, so walking it can never dirty the pane.
      -->
      <Grid Margin="20,16,20,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="txtStatusTabHeading" Style="{StaticResource SectionHeaderStyle}"
                   Margin="0,0,0,6" Text="Status" />
        <TextBlock Grid.Row="1" x:Name="txtStatusSummary" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
          <Button x:Name="btnStatusRefresh" Content="Refresh now" Padding="10,4" Click="OnStatusRefresh" />
          <TextBlock x:Name="txtStatusCadence" Style="{StaticResource SecondaryTextStyle}" Margin="10,0,0,0"
                     VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Live sessions refresh on their own while this tab is open; polling stops the moment you leave it." />
        </StackPanel>

        <DataGrid Grid.Row="3" x:Name="dgStatusSessions" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False" GridLinesVisibility="Horizontal" SelectionMode="Single"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="XProtect user" Binding="{Binding UserName}" Width="160" />
            <DataGridTextColumn Header="Client machine" Binding="{Binding ClientMachine}" Width="160" />
            <DataGridTextColumn Header="Open for" Binding="{Binding Duration}" Width="90" />
            <DataGridTextColumn Header="Idle" Binding="{Binding IdleFor}" Width="80" />
            <DataGridTextColumn Header="Requests" Binding="{Binding Requests}" Width="90" />
            <DataGridTextColumn Header="Requests/min" Binding="{Binding RequestsPerMinute}" Width="110" />
            <DataGridTextColumn Header="Sent" Binding="{Binding BytesSent}" Width="90" />
            <DataGridTextColumn Header="Received" Binding="{Binding BytesReceived}" Width="90" />
            <DataGridTextColumn Header="Send rate" Binding="{Binding SendRate}" Width="100" />
            <DataGridTextColumn Header="Receive rate" Binding="{Binding ReceiveRate}" Width="110" />
          </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" x:Name="statusError" Style="{StaticResource ErrorBannerStyle}"
                Visibility="Collapsed" Margin="0,10,0,0">
          <TextBlock x:Name="txtStatusError" Style="{StaticResource ErrorBannerTextStyle}" TextWrapping="Wrap" />
        </Border>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
