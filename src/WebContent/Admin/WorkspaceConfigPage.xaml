<UserControl x:Class="WebContent.Admin.WorkspaceConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="760"
             Background="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/WebContent;component/Admin/AdminPageStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!--
    Ticket #74: the workspace config page is now a tabbed shell. The Settings tab carries the
    existing content verbatim; Proxy/Diagnostics/Status are landing panels for the epic tickets
    (#81/#85/#86, #84, #76) and hold NO input controls - a placeholder tab must never dirty the
    pane. Status starts collapsed: the item manager shows it only after the workspace item's
    SecurityActions Manage (edit-rights) check passes for the current MC user.
    Tab x:Names are UIA AutomationIds - the ux probes and later tickets select tabs by them.
  -->
  <TabControl x:Name="workspaceTabs" Background="White"
              BorderBrush="{StaticResource Brush.Card.Border}" BorderThickness="0,1,0,0">
    <TabControl.Resources>
      <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,6" />
      </Style>
    </TabControl.Resources>

    <TabItem x:Name="tabSettings" Header="Settings">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" Margin="20,16,20,24">

          <!-- Ticket #27: broken-definition banner, shown by SignalLoadDefect. -->
          <Border x:Name="configError" Style="{StaticResource ErrorBannerStyle}" Visibility="Collapsed">
            <TextBlock x:Name="configErrorText" Style="{StaticResource ErrorBannerTextStyle}" />
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Name:" />
              <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1"
                       Style="{StaticResource FormTextBoxStyle}" Text="New Workspace"
                       MaxLength="128" TextChanged="OnUserChanged" />

              <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Home address:" />
              <TextBox x:Name="txtHomeAddress" Grid.Row="1" Grid.Column="1"
                       Style="{StaticResource FormTextBoxStyle}"
                       MaxLength="2048" TextChanged="OnUserChanged" />
            </Grid>
          </Border>

          <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Display" />
          <CheckBox x:Name="chkHideToolbar" Content="Hide toolbar"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnHideToolbarChanged" Unchecked="OnHideToolbarChanged" />
          <CheckBox x:Name="chkHideAddress" Content="Hide address"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblZoomLevel" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Zoom level:" Margin="0,6,12,6" />
            <TextBox x:Name="txtZoomLevel" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"
                     Width="70" Text="100" TextAlignment="Right"
                     MaxLength="4" TextChanged="OnZoomLevelTextChanged" />
            <Slider x:Name="zoomSlider" Grid.Column="2" Minimum="25" Maximum="500" Value="100"
                    TickFrequency="25" TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                    LargeChange="25" SmallChange="5" VerticalAlignment="Center"
                    Margin="12,0,0,0" MaxWidth="360" HorizontalAlignment="Left" Width="360"
                    ValueChanged="OnZoomSliderValueChanged" />
          </Grid>

          <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Behavior" />
          <CheckBox x:Name="chkRememberLastAddress" Content="Remember last address"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />
          <CheckBox x:Name="chkAllowBackgroundBrowser" Content="Allow browser to run in background"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />
          <CheckBox x:Name="chkAllowAudioNotifications" Content="Allow audio notifications"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />
          <CheckBox x:Name="chkMuteAudio" Content="Mute audio"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />

          <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Privacy" />
          <CheckBox x:Name="chkClearBrowsingDataOnExit" Content="Clear history on exit"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />

          <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Advanced" />
          <CheckBox x:Name="chkIsolateBrowserInstances" Content="Isolate this browser instance"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />
          <CheckBox x:Name="chkEnableDevTools" Content="Enable developer tools (F12)"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />

          <!-- Ticket #52: server-side proxy toggle + target allowlist. Routing itself ships in #54; -->
          <!-- here the setting only travels to the view item properties. #74 keeps these on Settings -->
          <!-- verbatim; #81's structured grid moves the allowlist onto the Proxy tab. -->
          <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Proxy" />
          <CheckBox x:Name="chkProxyEnabled" Content="Route web traffic through the VMS server proxy"
                    Style="{StaticResource OptionCheckBoxStyle}" Checked="OnUserChanged" Unchecked="OnUserChanged" />
          <TextBlock x:Name="lblProxyTargets" Style="{StaticResource FieldLabelStyle}" Text="Proxy targets:" Margin="0,6,0,2" />
          <TextBox x:Name="txtProxyTargets" Style="{StaticResource FormTextBoxStyle}"
                     AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="56"
                     VerticalScrollBarVisibility="Auto" MaxLength="4096" TextChanged="OnProxyTargetsTextChanged" />
          <TextBlock x:Name="lblProxyTargetsHint" Style="{StaticResource SecondaryTextStyle}"
                     TextWrapping="Wrap" Margin="0,2,0,0" />

          <!-- Ticket #53 demo harness: Management Client-driven proxy fetch across MIP messaging. -->
          <TextBlock x:Name="lblProxyTestUrl" Style="{StaticResource FieldLabelStyle}" Text="Test proxy fetch:" Margin="0,10,0,2" />
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="txtProxyTestUrl" Style="{StaticResource FormTextBoxStyle}" Width="470"
                     VerticalAlignment="Center" MaxLength="2048" />
            <Button x:Name="btnProxyTestFetch" Content="Fetch via Event Server" Margin="10,0,0,0"
                    Padding="10,4" VerticalAlignment="Center" Click="OnProxyTestFetch" />
          </StackPanel>
          <TextBlock x:Name="lblProxyTestHint" Style="{StaticResource SecondaryTextStyle}"
                     TextWrapping="Wrap" Margin="0,2,0,0" />
          <TextBlock x:Name="lblProxyTestResult" Style="{StaticResource SecondaryTextStyle}"
                     TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="Bold" Visibility="Collapsed" />

        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem x:Name="tabProxy" Header="Proxy">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" Margin="20,16,20,24">
          <TextBlock x:Name="txtProxyTabHeading" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" Text="Proxy" />
          <TextBlock x:Name="txtProxyTabPlaceholder" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                     Text="The structured proxy allowlist grid (#81), the per-workspace response size cap (#85), the request header policy (#86) and the rule triggers (#78/#79) land on this tab. Until they ship, proxy routing and the target allowlist stay on the Settings tab." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem x:Name="tabDiagnostics" Header="Diagnostics">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" Margin="20,16,20,24">
          <TextBlock x:Name="txtDiagnosticsTabHeading" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" Text="Diagnostics" />
          <TextBlock x:Name="txtDiagnosticsTabPlaceholder" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                     Text="Recently blocked proxy resources for this workspace, with one-click promotion into the allowlist, land on this tab (#69/#84)." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem x:Name="tabStatus" Header="Status" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" Margin="20,16,20,24">
          <TextBlock x:Name="txtStatusTabHeading" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" Text="Status" />
          <TextBlock x:Name="txtStatusTabPlaceholder" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"
                     Text="Live proxy sessions for this workspace land on this tab (#69/#76). The tab renders only for users who hold the workspace's Manage security action." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
