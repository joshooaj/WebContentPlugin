<?xml version="1.0" encoding="utf-8"?>
<!--
  Plugin-owned styles for the Management Client pages. The Management Client
  does not supply Smart Client WPF theme resources, so every key the pages
  use is defined here (see the MIP SDK WPF-in-Management-Client guidance).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="Brush.Text" Color="#FF1F2933" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#FF5A6672" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#FF0072C2" />
  <SolidColorBrush x:Key="Brush.Card.Background" Color="#FFFBFBFC" />
  <SolidColorBrush x:Key="Brush.Card.Border" Color="#FFD8DCE1" />
  <SolidColorBrush x:Key="Brush.Input.Border" Color="#FFB7BEC6" />
  <SolidColorBrush x:Key="Brush.Error.Background" Color="#FFFCEBEC" />
  <SolidColorBrush x:Key="Brush.Error.Border" Color="#FFC0392B" />
  <SolidColorBrush x:Key="Brush.Error.Foreground" Color="#FF8A1F1F" />

  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Margin" Value="0,18,0,4" />
  </Style>

  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,2" />
  </Style>

  <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,2" />
  </Style>

  <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,6,12,6" />
  </Style>

  <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Input.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Margin" Value="0,4,0,4" />
  </Style>

  <Style x:Key="OptionCheckBoxStyle" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="Margin" Value="0,5,0,5" />
    <Setter Property="Padding" Value="2,0,0,0" />
  </Style>

  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Card.Background}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Card.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="ErrorBannerStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Error.Background}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Error.Border}" />
    <Setter Property="BorderThickness" Value="4,0,0,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,0,0,14" />
  </Style>

  <Style x:Key="ErrorBannerTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Error.Foreground}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="StepNumberStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="StepBadgeStyle" TargetType="Border">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style x:Key="StepTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

</ResourceDictionary>
