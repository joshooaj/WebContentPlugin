<client:ViewItemWpfUserControl x:Class="WebContent.Client.WebContentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:client="clr-namespace:VideoOS.Platform.Client;assembly=VideoOS.Platform"
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:local="clr-namespace:WebContent.Client"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200">
    <UserControl.DataContext>
        <local:WebContentViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <DockPanel Name="BrowserControl">
        <DockPanel Name="Toolbar" DockPanel.Dock="Top" LastChildFill="True" Visibility="{Binding ToolbarVisibility, Mode=OneWay}" PreviewMouseDown="WebContentUserControl_PreviewMouseDown" Background="Transparent">
            <Button Command="{Binding BackCommand}" Margin="2">
                <fa:ImageAwesome Name="NavBack" Icon="ChevronLeft" Height="12"/>
            </Button>
            <Button Command="{Binding ForwardCommand}" Margin="2">
                <fa:ImageAwesome Name="NavForward" Icon="ChevronRight" Height="12"/>
            </Button>
            <Button Command="{Binding ReloadCommand}" Margin="2">
                <fa:ImageAwesome Name="NavRefresh" Icon="Refresh" Height="12"/>
            </Button>
            <Button Command="{Binding HomeCommand}" CommandParameter="{Binding Home}" Margin="2">
                <fa:ImageAwesome Name="NavHome" Icon="Home" Height="12"/>
            </Button>
            <Button Command="{Binding PrintCommand}" Margin="2">
                <fa:ImageAwesome Name="NavPrint" Icon="Print" Height="12"/>
            </Button>
            <TextBox Name="addressBar" VerticalContentAlignment="Center" Visibility="{Binding AddressVisibility}" Text="{Binding Address, Mode=OneWay}" KeyDown="addressBar_KeyDown" FontWeight="Medium" Margin="2" Padding="5 0 0 0" IsEnabled="{Binding IsAddressEnabled}" />
        </DockPanel>
        <DockPanel Name="Panel" Background="DimGray" MouseDown="ViewItemWpfUserControl_MouseDown">
            <TextBlock Name="FloatingPlaceholder" Visibility="{Binding IsWorkspaceFloating, Converter={StaticResource BooleanToVisibilityConverter}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Foreground="LightGray" FontSize="14">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}&#10;&#10;{1}">
                        <Binding Source="This workspace is currently displayed in a floating window."/>
                        <Binding Source="Close the floating window to return the browser here."/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DockPanel>
    </DockPanel>
</client:ViewItemWpfUserControl>
