<client:ViewItemWpfUserControl x:Class="WebContent.Client.WebContentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:client="clr-namespace:VideoOS.Platform.Client;assembly=VideoOS.Platform"
             xmlns:platformUiControls="clr-namespace:VideoOS.Platform.UI.Controls;assembly=VideoOS.Platform"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:local="clr-namespace:WebContent.Client"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200">
    <UserControl.DataContext>
        <local:WebContentViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <DockPanel Name="BrowserControl">
        <StackPanel Name="Toolbar" DockPanel.Dock="Top" Visibility="{Binding ToolbarVisibility, Mode=OneWay}" PreviewMouseDown="WebContentUserControl_PreviewMouseDown" Background="Transparent">
            <DockPanel Name="ToolbarRow" LastChildFill="True">
                <platformUiControls:VideoOSButtonTransparentSmall Name="NavBack" Command="{Binding BackCommand}" Margin="0 2 1 2">
                    <platformUiControls:VideoOSButtonTransparentSmall.IconSource>
                        <platformUiControls:VideoOSIconBuiltInSource Icon="Chevron_Left"/>
                    </platformUiControls:VideoOSButtonTransparentSmall.IconSource>
                </platformUiControls:VideoOSButtonTransparentSmall>
                <platformUiControls:VideoOSButtonTransparentSmall Name="NavForward" Command="{Binding ForwardCommand}" Margin="1 2">
                    <platformUiControls:VideoOSButtonTransparentSmall.IconSource>
                        <platformUiControls:VideoOSIconBuiltInSource Icon="Chevron_Right"/>
                    </platformUiControls:VideoOSButtonTransparentSmall.IconSource>
                </platformUiControls:VideoOSButtonTransparentSmall>
                <platformUiControls:VideoOSButtonTransparentSmall Name="NavReload" Command="{Binding ReloadCommand}" Margin="1 2">
                    <platformUiControls:VideoOSButtonTransparentSmall.IconSource>
                        <platformUiControls:VideoOSIconBuiltInSource Icon="Refresh"/>
                    </platformUiControls:VideoOSButtonTransparentSmall.IconSource>
                </platformUiControls:VideoOSButtonTransparentSmall>
                <platformUiControls:VideoOSButtonTransparentSmall Name="NavHome" Command="{Binding HomeCommand}" CommandParameter="{Binding Home}" Margin="1 2">
                    <platformUiControls:VideoOSButtonTransparentSmall.IconSource>
                        <platformUiControls:VideoOSIconBuiltInSource Icon="Home"/>
                    </platformUiControls:VideoOSButtonTransparentSmall.IconSource>
                </platformUiControls:VideoOSButtonTransparentSmall>
                <platformUiControls:VideoOSButtonTransparentSmall Name="NavPrint" DockPanel.Dock="Right" Command="{Binding PrintCommand}" Margin="2">
                    <platformUiControls:VideoOSButtonTransparentSmall.IconSource>
                        <platformUiControls:VideoOSIconBuiltInSource Icon="Print"/>
                    </platformUiControls:VideoOSButtonTransparentSmall.IconSource>
                </platformUiControls:VideoOSButtonTransparentSmall>
                <!-- #83: setup-mode blocked-resources indicator. Collapsed while the tally is
                     zero or the client is in runtime mode; click opens the per-page-load list. -->
                <platformUiControls:VideoOSButtonTransparentSmall Name="blockedIndicator" DockPanel.Dock="Right" Visibility="Collapsed" Click="blockedIndicator_Click" Margin="2">
                    <TextBlock Name="blockedIndicatorText" VerticalAlignment="Center" Margin="2 0" />
                </platformUiControls:VideoOSButtonTransparentSmall>
                <platformUiControls:VideoOSTextBoxSmall Name="addressBar" VerticalContentAlignment="Center" Visibility="{Binding AddressVisibility}" Text="{Binding Address, Mode=OneWay}" KeyDown="addressBar_KeyDown" Margin="0 2 2 2" IsEnabled="{Binding IsAddressEnabled}" />
            </DockPanel>
            <platformUiControls:VideoOSInlineMessageSmall Name="addressWarning" Appearance="Error" Visibility="Collapsed" MinLines="1" MaxLines="2" Margin="0 0 0 2" />
            <!-- #83: per-view-instance list of what the loopback listener refused this page load:
                 canonical origin (selectable for copying), refusal category, hit count. -->
            <Border Name="blockedResourcesPanel" Visibility="Collapsed" Margin="0 0 0 2" Padding="4" BorderThickness="1" BorderBrush="Gray" Background="#33000000">
                <StackPanel Name="blockedResourcesRows" />
            </Border>
        </StackPanel>
        <!-- #72: untrusted deployment-CA banner, shown for ALL users of a proxied view whose
             loopback leaf chains to a CA this machine's trusted-root stores do not hold (the
             browser itself shows its own certificate error under this strip). Informational for
             ordinary users: dismiss for this session only. The "Fix certificate trust" button is
             setup-mode-only and launches the bundled elevated helper (WebContentTrustHelper.exe);
             Windows' elevation prompt and crypt32's root-store warning both ride it, unsuppressed.
             Collapsed while the CA is trusted, unknown (no mint yet), or dismissed this session. -->
        <Border Name="proxyCaBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0 2" Padding="6 4" BorderThickness="1" BorderBrush="#80C8860E" Background="#40C8860E">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="proxyCaBannerText" Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="White" />
                <platformUiControls:VideoOSButtonTransparentSmall Name="proxyCaFixButton" Grid.Column="1" Visibility="Collapsed" Click="proxyCaFixButton_Click" Margin="8 0 2 0">
                    <TextBlock Name="proxyCaFixButtonText" VerticalAlignment="Center" Margin="2 0" />
                </platformUiControls:VideoOSButtonTransparentSmall>
                <platformUiControls:VideoOSButtonTransparentSmall Name="proxyCaDismissButton" Grid.Column="2" Click="proxyCaDismissButton_Click" Margin="2 0 0 0">
                    <TextBlock Text="&#x2715;" VerticalAlignment="Center" Margin="2 0" />
                </platformUiControls:VideoOSButtonTransparentSmall>
            </Grid>
        </Border>
        <DockPanel Name="Panel" Background="DimGray" MouseDown="ViewItemWpfUserControl_MouseDown">
            <TextBlock Name="FloatingPlaceholder" Visibility="{Binding IsWorkspaceFloating, Converter={StaticResource BooleanToVisibilityConverter}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Foreground="LightGray" FontSize="14">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}&#10;&#10;{1}">
                        <Binding Source="This workspace is currently displayed in a floating window."/>
                        <Binding Source="Close the floating window to return the browser here."/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DockPanel>
    </DockPanel>
</client:ViewItemWpfUserControl>
