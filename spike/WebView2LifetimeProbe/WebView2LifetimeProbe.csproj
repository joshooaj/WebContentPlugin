<Project Sdk="Microsoft.NET.Sdk">

  <!--
    #90 spike host (throwaway): a WebView2 host app that runs as 'creator' or 'joiner' against
    one shared user data folder with identical options, for the browser-process lifetime probe.
    Not shipped, never referenced by the plugin; built with the UxTests project (ProjectReference)
    and launched as a separate process. See WebView2LifetimeProbeTests.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WebView2LifetimeProbe</AssemblyName>
    <RootNamespace>WebView2LifetimeProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
